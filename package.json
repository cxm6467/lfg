{
  "name": "lfg",
  "version": "0.0.1",
  "description": "LFG Node.js Discord.js bot",
  "main": "./app.ts",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node app.ts",
    "build": "tsc",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "prebuild": "npm run clean && npm run typecheck && npm run lint",
    "postbuild": "npm run test",
    "lint": "eslint \"**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config=./jest.config.js",
    "test:watch": "jest --config=./jest.config.js --watch",
    "test:coverage": "jest --config=./jest.config.js --coverage",
    "test:ci": "jest --config=./jest.config.js --coverage --ci --watchAll=false",
    "health": "node -e \"console.log('Health check passed')\"",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cxm6467/lfg.git"
  },
  "keywords": [
    "wow",
    "lfg",
    "node",
    "discord",
    "mythic+",
    "'mythic",
    "plus'",
    "normal",
    "dungeons",
    "dungeon",
    "heroic",
    "mythic",
    "war",
    "within'",
    "wwi"
  ],
  "author": "Chris Marasco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cxm6467/lfg/issues"
  },
  "homepage": "https://github.com/cxm6467/lfg#readme",
  "dependencies": {
    "@logtail/node": "^0.5.2",
    "@types/chalk": "^0.4.31",
    "bcryptjs": "^3.0.2",
    "chalk": "^4.1.2",
    "chrono-node": "^2.7.7",
    "discord.js": "^14.16.2",
    "dotenv": "^16.4.5",
    "ical-generator": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "l": "^0.6.0",
    "luxon": "^3.5.0",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.6.2",
    "node-cron": "^4.2.1",
    "node-schedule": "^2.1.1",
    "rrule": "^2.8.1",
    "ts-node": "^10.9.2",
    "typescript": ">=4.7.4 <5.6.0",
    "uuid": "^10.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.4.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@typescript-eslint/typescript-estree": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^15.10.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript-eslint": "^8.8.0"
  }
}
